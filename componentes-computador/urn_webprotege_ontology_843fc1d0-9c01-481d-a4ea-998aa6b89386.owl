    <!-- http://webprotege.stanford.edu/R8RMReEjPCZKOVtWGK4ywr2 -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R8RMReEjPCZKOVtWGK4ywr2">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBTvie5Twzg9qzVjrNpZM7P"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://webprotege.stanford.edu/R7A4aPV6MLqirBTUsx8JW28"/>
                <owl:someValuesFrom rdf:resource="http://webprotege.stanford.edu/RDIEoi0r1BwiTKBzg1Tpu8k"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://webprotege.stanford.edu/RBpcwPZsqpJkbhiedpMTUEf"/>
                <owl:someValuesFrom rdf:resource="http://webprotege.stanford.edu/RBmlmMs1UuhQOA1N1wpinlh"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:description xml:lang="en">A liquid cooler, often referred to as a &quot;water cooler,&quot; is a cooling system that uses a liquid (typically a mixture of distilled water and additives) to dissipate heat from electronic components, such as central processing units (CPUs) and graphics processing units (GPUs) in computers. The liquid absorbs heat from the component, is pumped to a radiator where the heat is transferred to the air, and then the cooled liquid returns to the component. It generally offers superior cooling performance compared to air-based solutions.</dc:description>
        <dc:description xml:lang="pt-br">Um resfriador líquido, frequentemente chamado de &quot;water cooler&quot;, é um sistema de arrefecimento que utiliza um líquido (geralmente uma mistura de água destilada e aditivos) para dissipar o calor de componentes eletrônicos, como processadores (CPUs) e placas de vídeo (GPUs) em computadores. O líquido absorve o calor do componente, é bombeado para um radiador onde o calor é transferido para o ar, e então o líquido resfriado retorna ao componente. Oferece um desempenho de resfriamento superior em comparação com soluções a ar.</dc:description>
        <rdfs:label xml:lang="en">LiquidCooler</rdfs:label>
        <rdfs:label xml:lang="pt-br">Resfriador Líquido</rdfs:label>
    </owl:Class>
    


