        <rdfs:label xml:lang="pt-br">sequência de inicialização</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RBTvie5Twzg9qzVjrNpZM7P -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RBTvie5Twzg9qzVjrNpZM7P">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RDIEoi0r1BwiTKBzg1Tpu8k"/>
