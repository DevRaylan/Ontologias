    <!-- http://webprotege.stanford.edu/R9sZcJRlVaseCfaXTcbNRDU -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/R9sZcJRlVaseCfaXTcbNRDU">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/R7ZVbaRIPm4VqVr6SqOr9aL"/>
