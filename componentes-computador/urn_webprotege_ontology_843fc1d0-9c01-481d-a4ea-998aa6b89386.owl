        <rdfs:label xml:lang="pt-br">placa de rede</rdfs:label>
    </owl:Class>
    


    <!-- http://webprotege.stanford.edu/RB1JzICSK1id7bKwMUaAEMI -->

    <owl:Class rdf:about="http://webprotege.stanford.edu/RB1JzICSK1id7bKwMUaAEMI">
        <rdfs:subClassOf rdf:resource="http://webprotege.stanford.edu/RBTvie5Twzg9qzVjrNpZM7P"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://webprotege.stanford.edu/R7A4aPV6MLqirBTUsx8JW28"/>
                <owl:someValuesFrom rdf:resource="http://webprotege.stanford.edu/RDIEoi0r1BwiTKBzg1Tpu8k"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://webprotege.stanford.edu/RBpcwPZsqpJkbhiedpMTUEf"/>
                <owl:someValuesFrom rdf:resource="http://webprotege.stanford.edu/RBmlmMs1UuhQOA1N1wpinlh"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:description xml:lang="en">An air cooler, also known as an evaporative cooler, is a device that lowers air temperature through the evaporation of water. It draws in hot air, passes it over a wet pad where water evaporates and absorbs heat, then releases cooler, more humid air into the room. It differs from an air conditioner as it doesn&apos;t use refrigerants and is more effective in dry climates.</dc:description>
        <dc:description xml:lang="pt-br">Um resfriador a ar, também conhecido como climatizador evaporativo, é um aparelho que utiliza a evaporação da água para reduzir a temperatura do ar. Ele puxa o ar quente, faz com que ele passe por um painel úmido, onde a água evapora e absorve o calor, liberando ar mais fresco e úmido no ambiente. É diferente de um ar condicionado, pois não usa refrigerante e é mais eficiente em climas secos.</dc:description>
        <rdfs:label xml:lang="en">AirCooler</rdfs:label>
        <rdfs:label xml:lang="pt-br">AirCooler</rdfs:label>
    </owl:Class>
    


