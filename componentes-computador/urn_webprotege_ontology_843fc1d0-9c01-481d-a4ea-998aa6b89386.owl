            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:description xml:lang="pt-br">A CoolingSystem (Sistema de Resfriamento) é o componente de hardware responsável por controlar a temperatura dos componentes internos, especialmente CPU e GPU, evitando superaquecimento.</dc:description>
        <dc:description xml:lang="en">The cooling system is responsible for removing excess heat generated by a vehicle&apos;s engine, maintaining it at an optimal operating temperature to prevent overheating and ensure proper functioning.</dc:description>
        <rdfs:label xml:lang="en">CoolingSystem</rdfs:label>
        <rdfs:label xml:lang="pt-br">Sistema de Arrefecimento</rdfs:label>
    </owl:Class>
    


