                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Device</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dc:description xml:lang="en">A computer network is a set of computers sharing resources located on or provided by network nodes. … interconnections are made up of … wired, optical, and wireless radio-frequency methods that may be arranged in a variety of network topologies.</dc:description>
        <dc:description xml:lang="pt-br">Rede de computadores é um conjunto de computadores que compartilham recursos localizados em nós de rede. … interconexões são feitas por meios com fio, óptico ou sem fio (RF), organizados em várias topologias de rede.</dc:description>
        <rdfs:label xml:lang="en">Computer network</rdfs:label>
        <rdfs:label xml:lang="pt-br">conexão de rede</rdfs:label>
    </owl:Class>
    


